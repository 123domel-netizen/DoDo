# Skopiuj do .env i uzupełnij, aby włączyć synchronizację w chmurze (Supabase).
# Bez tych zmiennych aplikacja działa w trybie lokalnym (IndexedDB) na jednym urządzeniu.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Klucz publiczny VAPID do powiadomień Web Push (generowany razem z Edge Function).
VITE_VAPID_PUBLIC_KEY=

# Media: build-time kill switch ONLY.
# "legacy" — klient nie próbuje R2.
# "r2" — klient MOŻE użyć R2 wyłącznie gdy serwer ustawi orgs.media_pipeline=r2_sp.
# Sam Vite NIGDY nie włącza R2 dla zespołu.
#
# Buildy wystawiane użytkownikom biorą tę wartość z `.env.production` /
# `.env.projects-preview` (oba w repo, oba `r2`) — ten plik dotyczy tylko
# lokalnego dev. Ustawienie tu "legacy" przy zespole na r2_sp da lokalnie ten
# sam komunikat co na produkcji, więc do pracy nad galeriami zostaw "r2".
VITE_MEDIA_PIPELINE=r2
