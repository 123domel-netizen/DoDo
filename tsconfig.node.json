{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": ["node"]
  },
  // buildGuard jest dzielony przez konfigurację Vite i aplikację — celowo bez
  // importów, żeby esbuild mógł go wciągnąć do bundla konfiguracji.
  "include": ["vite.config.ts", "src/lib/media/buildGuard.ts"]
}
